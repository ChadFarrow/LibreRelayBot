# LibreRelayBot Configuration
# IRC to Nostr bridge for V4V boosts in the #SirLibre channel

# Required: Your Nostr private key (nsec1 format)
NOSTR_NSEC=nsec1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Custom Nostr relays (comma-separated). Defaults are used if unset.
# NOSTR_RELAYS=wss://relay.damus.io,wss://relay.nostr.band,wss://nostr.mom,wss://relay.primal.net,wss://chadf.nostr1.com

# IRC Configuration.
# In production IRC_SERVER is the ZNC container ("znc") on the compose bridge
# network, not ZeroNode directly -- ZNC multiplexes one ZeroNode connection across
# all three bots. Set IRC_PASSWORD to the clientid form so this bot is its own
# client on that shared connection:
#   IRC_PASSWORD=ircbots@lrb/zeronode:<znc password>
IRC_SERVER=znc
IRC_PORT=6667
IRC_SECURE=false
IRC_PASSWORD=
IRC_CHANNEL=#SirLibre
IRC_NICKNAME=LibreRelayReader
IRC_USERNAME=ircbots
IRC_REALNAME=LibreRelayBot Reader Bot

# Target Bot to Monitor -- only messages from this nick are relayed
TARGET_BOT=LibreRelayBot

# Application Settings
PORT=3336
TEST_MODE=false

# How long to wait after an IRC line before deciding a boost is complete. A long
# boost arrives as two or three lines and is rejoined into one Nostr note
# (lib/message-assembler.js); this is the idle gap that ends one.
IRC_JOIN_WINDOW_MS=2500

# A payer's app stores their mentions as keys, so a boost comment says
# "nostr:npub1cpd59…" where they typed a name. The bot looks the name up on the
# relays above and puts it in the note. Set to false to publish the raw key.
# Lookups are cached and cannot delay or fail a post.
RESOLVE_NPUB_NAMES=true
NPUB_RESOLVE_TIMEOUT_MS=4000

# Podcast Index API — resolves a show name to its feed GUID for NIP-73 tags.
# Optional: without these the bot still posts, just without podcast:guid tags.
# https://api.podcastindex.org/signup
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=
